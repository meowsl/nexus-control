# Web UI. Copy: cp .env.example .env
# From this directory: docker compose up --build
# Open http://127.0.0.1:8088
#
# Same Nexus URL as TUI/CLI: containers use the host network.

POSTGRES_PASSWORD=change-me-db
NEXUS_CONTROL_SECRET=change-me-to-a-long-random-string
NEXUS_URL=http://127.0.0.1:8081
NEXUS_VERIFY_SSL=false
NEXUS_CONTROL_COOKIE_SECURE=false
