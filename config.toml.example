# Пример XDG-конфига nexus-control
# Обычно создаётся автоматически при первом запуске (first-run wizard).
# Путь по умолчанию: ~/.config/nexus-control/config.toml
# Переопределение: NEXUS_CONTROL_CONFIG=/path/to/config.toml
#
# Приоритет: OS env > CWD .env (legacy) > этот файл > defaults
# Username/password сюда НЕ кладите — prompt + encrypted vault.

nexus_url = "http://localhost:8081"
nexus_verify_ssl = true
locale = "ru"
# Для удалённого Nexus с большой латентностью увеличьте timeout (сек на запрос).
# nexus_timeout = 60.0
# nexus_session_ttl = 3600
# nexus_docker_registry = "localhost:8082"
# Кэш списка ассетов (сек); 0 = выкл.
# Свежий кэш → мгновенно без сети; просроченный → показать сразу + обновить в фоне.
# Refresh (r) всегда с сервера. По умолчанию 86400 (сутки).
# assets_cache_ttl = 86400

# scanners = "grype"          # или "trivy", "osv", или "grype,trivy,osv"
# Минимальная severity для FAIL (этот уровень и выше).
# negligible = любая находка (по умолчанию). Unknown всегда FAIL.
# CLI: --severity high   TUI: клавиша s   schedule: поле severity у правила
# severity = "negligible"
# DefectDojo: после verify FAIL-ассеты → Generic Findings Import (reimport-scan).
# API-ключ НЕ в TOML — vault (wizard / defectdojo configure) или DEFECTDOJO_API_KEY.
# defectdojo_enabled = false
# defectdojo_url = "http://localhost:8080"
# defectdojo_verify_ssl = true
# defectdojo_product_name = "nexus-control"
# defectdojo_engagement_name = ""   # пусто → имя Nexus-репозитория
# defectdojo_product_type_name = "Nexus"
# Webhook: POST compact JSON after each verify. Secrets NOT in TOML —
# vault (wizard / webhook configure) or WEBHOOK_TOKEN / WEBHOOK_USERNAME+PASSWORD.
# webhook_enabled = false
# webhook_url = "https://hooks.example.com/scan"
# webhook_auth = "none"   # none | bearer | basic | header
# webhook_header_name = "X-Api-Key"   # only for auth=header
# webhook_verify_ssl = true
# webhook_timeout = 15.0
# Параллельная обработка ассетов (download/scan/verify). 0 = auto (CPU/RAM).
# CLI: --workers N. Явное значение перекрывает auto.
# pipeline_workers = 0
# Глобальный лимит процессов сканеров (все ассеты × scanners). 0 = auto.
# CLI: --max-scanner-procs N
# max_scanner_procs = 0
# Stop new downloads if the data volume is this full (default 95%).
# disk_critical_watermark = 0.95
# Неизменённый PASS-ассет повторно не сканируется в пределах TTL.
# После TTL checkpoint протухает, чтобы учитывать обновления vulnerability DB.
# 0 = всегда сканировать. По умолчанию 86400 (сутки).
# scan_checkpoint_ttl = 86400
# Сколько последних verify-прогонов хранить (TUI h / CLI history). 0 = выкл.
# scan_history_keep = 50

# --- VK Teams (VK Workspace Bot API) -----------------------------------------
# Уведомления только от scheduler после завершения правила.
# Бот: @Metabot → /newbot → token. API URL — у админов / Metabot /start
# (часто https://myteam.mail.ru/bot/v1; on-prem — свой).
# Токен НЕ кладите сюда: nexus-control-cli vk-teams configure → vk-teams.vault
# vk_teams_api_url = "https://myteam.mail.ru/bot/v1"
# vk_teams_chat_id = ""
# vk_teams_notify = "off"          # off | always | failures
# vk_teams_upload_button = true    # кнопка Upload для action=verify
# vk_teams_verify_ssl = true
# vk_teams_timeout = 30.0

# download_root = "~/nexus-control/downloads"
# reports_root = "~/nexus-control/reports"
# verified_root = "~/nexus-control"
# PASS → *-verified: auto = hardlink (same FS) else copy; copy = всегда copy2.
# verified_link_mode = "auto"
# log_file = "~/nexus-control/logs/nexus-control.log"

# grype_use_docker = "auto"
# trivy_use_docker = "auto"
# osv_use_docker = "auto"
# osv_docker_image = "ghcr.io/google/osv-scanner:latest"
# osv_extra_args = ""
