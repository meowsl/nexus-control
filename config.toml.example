# Пример XDG-конфига nexus-control
# Обычно создаётся автоматически при первом запуске (first-run wizard).
# Путь по умолчанию: ~/.config/nexus-control/config.toml
# Переопределение: NEXUS_CONTROL_CONFIG=/path/to/config.toml
#
# Приоритет: OS env > CWD .env (legacy) > этот файл > defaults
# Username/password сюда НЕ кладите — prompt + encrypted vault.

nexus_url = "http://localhost:8081"
nexus_verify_ssl = true
locale = "ru"
# Для удалённого Nexus с большой латентностью увеличьте timeout (сек на запрос).
# nexus_timeout = 60.0
# nexus_session_ttl = 3600
# nexus_docker_registry = "localhost:8082"
# Кэш списка ассетов (сек); 0 = выкл.
# Свежий кэш → мгновенно без сети; просроченный → показать сразу + обновить в фоне.
# Refresh (r) всегда с сервера. По умолчанию 86400 (сутки).
# assets_cache_ttl = 86400

# scanners = "grype"          # или "trivy", "osv", или "grype,trivy,osv"
# Параллельная обработка ассетов (download/scan/verify). 0 = auto (CPU/RAM).
# CLI: --workers N. Явное значение перекрывает auto.
# pipeline_workers = 0
# Глобальный лимит процессов сканеров (все ассеты × scanners). 0 = auto.
# CLI: --max-scanner-procs N
# max_scanner_procs = 0
# Disk-pressure: pause new downloads at high, resume after reclaim below low.
# disk_high_watermark = 0.80
# disk_low_watermark = 0.70
# disk_critical_watermark = 0.95
# disk_reclaim_enabled = true
# archive_root = "~/nexus-control/archive"
# Неизменённый PASS-ассет повторно не сканируется в пределах TTL.
# После TTL checkpoint протухает, чтобы учитывать обновления vulnerability DB.
# 0 = всегда сканировать. По умолчанию 86400 (сутки).
# scan_checkpoint_ttl = 86400
# Сколько последних verify-прогонов хранить (TUI h / CLI history). 0 = выкл.
# scan_history_keep = 50
# download_root = "~/nexus-control/downloads"
# reports_root = "~/nexus-control/reports"
# verified_root = "~/nexus-control"
# log_file = "~/nexus-control/logs/nexus-control.log"

# grype_use_docker = "auto"
# trivy_use_docker = "auto"
# osv_use_docker = "auto"
# osv_docker_image = "ghcr.io/google/osv-scanner:latest"
# osv_extra_args = ""
