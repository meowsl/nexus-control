# Example: copy to ~/.config/nexus-control/schedule.toml
# Manage via: nexus-control-cli schedule

[scheduler]
# local = timezone машины (/etc/timezone, $TZ). Можно задать IANA явно.
timezone = "local"
# If a previous job is still running: skip | queue | overlap
# queue (default) = run due jobs one-by-one ASAP after the current finishes
# skip = drop a due slot if another job is still marked busy
# overlap = reserved (v1 still sequential, same as queue)
overlap = "queue"

[[rules]]
id = "nightly-core"
enabled = true
cron = "0 3 * * 1-5"
description = "Основные maven/npm"
repos = ["maven-hosted", "npm-hosted"]
action = "verify_upload"
# Optional per-repo upload targets (default = <repo>-verified):
# targets = { maven-hosted = "maven-hosted-verified", npm-hosted = "npm-clean" }

[[rules]]
id = "weekend-raw"
enabled = true
cron = "30 4 * * 6"
description = "Сырые и pypi по субботам"
repos = ["raw-hosted", "pypi-hosted", "maven-snapshots"]
action = "verify"
upload = true
# scanners = "grype,trivy,osv"
# severity = "high"    # fail on high+; empty/omit = config default
# Single prefix (string) or several (array); both keys also merge if set together.
# GAV include (OR). Empty = whole repo.
# path_prefix = "com/example"
# path_prefixes = ["com/", "org/"]
# Skip download/scan for these prefixes (OR), after includes.
# maven-other: no path_prefix + excluded_prefixes = ["com/"] keeps root catalog.xml
# excluded_prefix = "com/"
# excluded_prefixes = ["com/", "org/experimental/"]
# workers = 4
# limit = 100          # max assets needing download/re-download
# scan_limit = 20      # max mains to verify (handy for debug on large repos)
