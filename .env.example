# =============================================================================
# Конфигурация nexus-tui
# Скопируйте в .env и заполните обязательные значения:
#   cp .env.example .env
# Переменные окружения ОС имеют приоритет над значениями из этого файла.
# =============================================================================

# --- Подключение к Nexus ------------------------------------------------------
# Базовый URL Nexus Repository CE (завершающий слэш не обязателен).
# Обязателен в .env / окружении.
NEXUS_URL=http://localhost:8081

# Учётные данные ОПЦИОНАЛЬНЫ в .env.
# Рекомендуемый режим: оставьте пустыми — при запуске в TTY утилита спросит
# username/password и сохранит их зашифрованно в NEXUS_CACHE_DIR/credentials.vault
# до истечения Nexus-сессии (NEXUS_SESSION_TTL). Пароль не пишется в session.json.
# Для CI / non-interactive задайте оба значения в окружении или здесь.
# NEXUS_USERNAME=admin
# NEXUS_PASSWORD=change_me
NEXUS_USERNAME=
NEXUS_PASSWORD=

# --- Клиент Nexus -------------------------------------------------------------
# Проверять TLS-сертификаты. false — только для self-signed в лаборатории
# (будет предупреждение в логе).
NEXUS_VERIFY_SSL=true

# Таймаут HTTP-запросов к Nexus в секундах.
NEXUS_TIMEOUT=30

# TTL локального кэша Nexus-сессии в секундах. Пока сессия валидна,
# credentials.vault можно переиспользовать без повторного prompt.
NEXUS_SESSION_TTL=3600

# Каталог кэша (~ раскрывается): session.json + credentials.vault + .vault_key.
# Права: dir 700, files 600.
NEXUS_CACHE_DIR=~/.cache/nexus-tui

# Опциональный hostname/port Docker Registry для docker-репозиториев.
# Пример: localhost:8082  (оставьте пустым для автоопределения из attributes).
NEXUS_DOCKER_REGISTRY=

# --- Локальные пути -----------------------------------------------------------
# Скачанные артефакты: DOWNLOAD_ROOT/<repository>/<asset_path>
DOWNLOAD_ROOT=~/nexus-automation/downloads

# Отчёты Grype JSON/TXT: REPORTS_ROOT/<repository>/<safe-path>.grype.json
REPORTS_ROOT=~/nexus-automation/reports

# Проверенные (чистые) артефакты: VERIFIED_ROOT/<repository>-verified/
# По умолчанию раскрывается в /home/<user>/nexus-automation на Linux.
VERIFIED_ROOT=~/nexus-automation

# --- Grype --------------------------------------------------------------------
# Имя или абсолютный путь локального бинарника grype.
GRYPE_BINARY=grype

# auto | true | false — использовать Docker-образ, если локальный grype не найден.
GRYPE_USE_DOCKER=auto

# Docker-образ для fallback-сканирования.
GRYPE_DOCKER_IMAGE=anchore/grype:latest

# Доп. аргументы CLI grype (через пробел). Парсятся как список, не через shell.
# Пример: --fail-on high
GRYPE_EXTRA_ARGS=

# --- Docker / skopeo (docker-репозитории) ------------------------------------
DOCKER_BINARY=docker
SKOPEO_BINARY=skopeo

# --- Логирование --------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Путь к ротируемому файлу лога.
LOG_FILE=~/nexus-automation/logs/nexus-tui.log

# --- Перезапись ---------------------------------------------------------------
# Принудительно перекачивать файл, даже если локальный checksum совпадает.
# При false (по умолчанию): skip если локальный файл совпадает с remote
# checksum (sha256/sha1/md5); при расхождении — перекачать и перезаписать.
OVERWRITE_DOWNLOADS=false

# Перезаписывать файл в verified, если он уже существует.
OVERWRITE_VERIFIED=false
