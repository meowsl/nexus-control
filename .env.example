# =============================================================================
# nexus-control — TUI и CLI
# Скопируйте:  cp .env.example .env
# Web UI живёт отдельно: web/.env.example + web/compose.yaml
# =============================================================================
#
# Обязательно: NEXUS_URL (если нет ~/.config/nexus-control/config.toml).
# Username/password для TTY не нужны — спросит при запуске.
# Для CI / scheduler без TTY задайте NEXUS_USERNAME и NEXUS_PASSWORD.
#
# Приоритет: переменные ОС > этот .env > config.toml
# =============================================================================

NEXUS_URL=http://localhost:8081
NEXUS_USERNAME=
NEXUS_PASSWORD=

# false — только self-signed в лаборатории
NEXUS_VERIFY_SSL=true

# NEXUS_CONTROL_LOCALE=ru
NEXUS_TIMEOUT=30
NEXUS_SESSION_TTL=3600
NEXUS_CACHE_DIR=~/.cache/nexus-control
NEXUS_DOCKER_REGISTRY=

# NEXUS_CONTROL_CONFIG=~/.config/nexus-control/config.toml
# NEXUS_CONTROL_SCHEDULE=~/.config/nexus-control/schedule.toml

DOWNLOAD_ROOT=~/nexus-control/downloads
REPORTS_ROOT=~/nexus-control/reports
VERIFIED_ROOT=~/nexus-control

SCANNERS=grype
# SEVERITY=high
# PIPELINE_WORKERS=0
# MAX_SCANNER_PROCS=0
# SCAN_CHECKPOINT_TTL=86400
# SCAN_HISTORY_KEEP=50

GRYPE_BINARY=grype
GRYPE_USE_DOCKER=auto
GRYPE_DOCKER_IMAGE=anchore/grype:latest
GRYPE_EXTRA_ARGS=

TRIVY_BINARY=trivy
TRIVY_USE_DOCKER=auto
TRIVY_DOCKER_IMAGE=aquasec/trivy:latest
TRIVY_EXTRA_ARGS=

OSV_BINARY=osv-scanner
OSV_USE_DOCKER=auto
OSV_DOCKER_IMAGE=ghcr.io/google/osv-scanner:latest
OSV_EXTRA_ARGS=
# OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY=~/.cache

DOCKER_BINARY=docker
SKOPEO_BINARY=skopeo

LOG_LEVEL=INFO
LOG_FILE=~/nexus-control/logs/nexus-control.log

OVERWRITE_DOWNLOADS=false
OVERWRITE_VERIFIED=false
# VERIFIED_LINK_MODE=auto

# Интеграции (опционально). CLI: nexus-control-cli defectdojo|webhook|vk-teams configure
# DEFECTDOJO_ENABLED=true
# DEFECTDOJO_URL=http://localhost:8080
# DEFECTDOJO_API_KEY=
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=
# VK_TEAMS_NOTIFY=off
# VK_TEAMS_TOKEN=
# VK_TEAMS_CHAT_ID=
